# REQUIRED BEFORE FIRST RUN: cp .env.example .env ; edit .env
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_48_RANDOM_CHARACTERS_OR_MORE
ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_14_PLUS_CHARACTER_PASSWORD
COOKIE_SECURE=true
# Verify YOUR business timezone. 774 is a MA area code, but that does not prove location.
BUSINESS_TIMEZONE=America/New_York
# Gmail SMTP with 2-step verification and an app password (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
